# ==============================================================================
# GuideMe Extension — Environment Configuration Example
# ==============================================================================

# ── Backend API & Web App URL ──
# Local dev: http://localhost:4000 | Production: https://api.guideme.app
WXT_API_URL=http://localhost:4000
WXT_SITE_URL=http://localhost:3000

# ── AI provider selection ──
# Do NOT put a provider API key (WXT_AI_API_KEY, etc.) in this file. Every
# WXT_*/VITE_* var here is compiled in plaintext into the shipped extension
# bundle, so secret keys go server-side in GuideMe-Backend/.env instead
# (OPENROUTER_API_KEY / GEMINI_API_KEY) and the extension calls WXT_API_URL.
WXT_AI_PROVIDER=openai
# Optional bring-your-own-key fallback for direct Gemini calls from the
# extension itself — leave unset in normal builds; end users set their own
# key from the extension Settings panel instead.
# WXT_GEMINI_API_KEY=


# ── Universal AI TTS Configuration (Plug-and-Play) ──
# AI API Key (Injected automatically into headers/query params)
WXT_TTS_API_KEY=your-provider-api-key

# Provider Preset Selection:
# Available presets: 'openai' | 'elevenlabs' | 'google-cloud' | 'azure-speech' | 'custom'
WXT_TTS_PRESET=openai

# Model & Voice Configuration
WXT_TTS_MODEL=tts-1
WXT_TTS_VOICE=alloy
