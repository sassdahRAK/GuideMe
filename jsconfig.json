{
  "compilerOptions": {
    "checkJs": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@guideme/engine": ["./packages/engine/src/index.js"],
      "@guideme/engine/*": ["./packages/engine/src/*"],
      "@guideme/chrome-adapter": ["./packages/chrome-adapter/src/index.js"],
      "@guideme/tutorial-ui": ["./packages/tutorial-ui/src/index.js"]
    }
  },
  "exclude": ["node_modules", "dist", ".output", ".wxt"]
}
