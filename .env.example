# ==============================================================================
# GuideMe Extension — Universal AI TTS Configuration (Plug-and-Play)
# Copy this file to apps/chrome-extension/.env and fill in your API key
# ==============================================================================

# 1. AI API Key (Injected automatically into headers/query params)
WXT_TTS_API_KEY=

# 2. Provider Preset Selection:
# Available presets: 'openai' | 'elevenlabs' | 'google-cloud' | 'azure-speech' | 'custom'
WXT_TTS_PRESET=openai

# 3. Model & Voice Configuration
WXT_TTS_MODEL=tts-1
WXT_TTS_VOICE=alloy

# ==============================================================================
# ADVANCED / CUSTOM AI ENDPOINT CONFIGURATION (Optional: for any AI server/proxy)
# ==============================================================================
# WXT_TTS_ENDPOINT=https://api.your-custom-ai.com/v1/tts/synthesize
# WXT_TTS_HEADERS={"Authorization": "Bearer {{API_KEY}}", "X-Custom-Header": "GuideMe"}
# WXT_TTS_BODY_TEMPLATE={"text": "{{TEXT}}", "language": "{{LANG}}", "speed": {{RATE}}, "voice": "{{VOICE}}"}
# WXT_TTS_RESPONSE_TYPE=binary
# WXT_TTS_JSON_FIELD=audioContent
